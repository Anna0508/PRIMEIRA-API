def criar_usuario_exemplo(email: str, senha: str, name: str = "Usuário Exemplo", role: str = "admin"):
    session = SessionLocal()
    try:
        existente = session.query(Usuario).filter(Usuario.email == email).first()
        if existente:
            print(f"Já existe um usuário com o e-mail {email}.")
            return

        novo_usuario = Usuario(
            email=email,
            name=name,
            password=hasher.hash(senha),
            role=role,
            active=True,
        )
        session.add(novo_usuario)
        session.commit()
        print(f"Usuário {email} criado com sucesso. id={novo_usuario.id}")
    except Exception as e:
        session.rollback()
        print(f"Erro ao criar usuário: {e}")
    finally:
        session.close()

if __name__ == "__main__":
    criar_usuario_exemplo("admin@email.com", "senha123")
